---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { strings } from '../../lib/i18n';
import { allPosts, blogHome, formatDate, PROJECTS, postPath, publishedPosts, SITE, tagPath, tagsOf } from '../../lib/posts';

export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const lang = post.data.lang;
const t = strings[lang];
const project = PROJECTS[post.data.project];
const { Content } = await render(post);
const path = postPath(post);
const translation = post.data.translation ? (await allPosts()).find((p) => p.id === post.data.translation && p.data.status === 'published') : undefined;
const alternates =
  translation && translation.data.lang !== lang
    ? lang === 'en'
      ? { en: path, tr: postPath(translation) }
      : { en: postPath(translation), tr: path }
    : { en: path, tr: path };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Zanaat', url: SITE },
  mainEntityOfPage: `${SITE}${path}`,
  image: `${SITE}/og/${post.id}.png`,
};
---

<Base lang={lang} title={`${post.data.title} · Zanaat`} description={post.data.description} path={path} alternates={alternates} ogImage={`/og/${post.id}.png`} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class:list={['post', post.data.project]}>
    <article>
      <header class="head">

        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="meta-row">
          <a class="project" href={tagPath(lang, post.data.project)}><img src={project.mark} alt="" />{project.name}</a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          {translation && <a class="translation" href={postPath(translation)} hreflang={translation.data.lang} lang={translation.data.lang}>{t.blog.translation}</a>}
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="end">
        <ul class="tags" aria-label="Tags">
          {tagsOf(post).map((tag) => <li><a href={tagPath(lang, tag)}>{tag}</a></li>)}
        </ul>
        <a class="back" href={blogHome(lang)}>{t.blog.back}</a>
      </footer>
    </article>

    <aside class="about" aria-label={t.blog.about}>
      <img class="about-mark" src={project.mark} alt="" />
      <p class="about-name">{project.name}</p>
      <p class="about-desc">{t.projects[post.data.project]}</p>
      <a class="about-link" href={project.href}>{project.href.replace(/^https:\/\//, '').replace(/\/$/, '')} <svg class="arr" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6h8M6.5 3l3 3-3 3" /></svg></a>
    </aside>
  </main>
</Base>

<style>
  .post {
    display: grid; grid-template-columns: minmax(0, 1fr) calc(220 * var(--u)); column-gap: calc(80 * var(--u));
    padding: calc(70 * var(--u)) calc(57 * var(--u)) calc(120 * var(--u));
  }
  /* A post sits in one project's ink; nothing else on the page takes the colour. */
  .post.lonca { --accent: var(--lonca-ink); }
  .post.baron { --accent: var(--baron); }
  .post.zanaat { --accent: var(--ink); }

  article { min-width: 0; }
  .head { display: grid; gap: calc(16 * var(--u)); margin-bottom: calc(44 * var(--u)); max-width: min(100%, calc(760 * var(--u))); }
  .meta-row { margin: calc(4 * var(--u)) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px calc(20 * var(--u)); font-family: var(--mono); font-size: calc(13.5 * var(--u)); color: #8a8a87; }
  .project { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); text-decoration: none; }
  .project img { width: calc(15 * var(--u)); height: auto; }
  .project:hover { color: var(--ink); }
  .translation { color: var(--accent); }
  h1 { margin: 0; font-family: var(--serif); font-size: clamp(32px, calc(40 * var(--u)), 54px); font-weight: 400; line-height: 1.14; letter-spacing: -0.015em; text-wrap: balance; font-variation-settings: 'opsz' 144; }
  .lede { margin: 0; max-width: 60ch; font-size: clamp(18px, calc(17 * var(--u)), 23px); line-height: 1.45; color: #a9a9a6; text-wrap: pretty; }

  /* Reading text holds a readable size and measure whatever the page scale does. */
  .prose { max-width: 68ch; font-size: clamp(17px, calc(15 * var(--u)), 20px); line-height: 1.68; color: #d3d2cd; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote), .prose :global(pre), .prose :global(figure) { margin-bottom: 0; }
  .prose :global(h2) { margin: 2.2em 0 0; font-family: var(--serif); font-size: 1.4em; font-weight: 400; line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); }
  .prose :global(h3) { margin: 1.8em 0 0; font-size: 1.15em; font-weight: 600; line-height: 1.3; color: var(--ink); }
  .prose :global(h2 + *), .prose :global(h3 + *) { margin-top: 0.6em; }
  .prose :global(a) { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: #8a8a87; }
  .prose :global(blockquote) { margin-left: 0; padding-left: 1.1em; border-left: 1px solid #3a3b3e; color: #b4b3ae; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .prose :global(:not(pre) > code) { font-family: var(--mono); font-size: 0.86em; padding: 0.12em 0.36em; border-radius: 4px; background: #1a1b1d; color: #e2e1dc; }
  .prose :global(pre) {
    font-family: var(--mono); font-size: clamp(13.5px, calc(12 * var(--u)), 15.5px); line-height: 1.6;
    padding: 1.1em 1.25em; border-radius: 8px; border: 1px solid #222326; overflow-x: auto;
  }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9em; font-variant-numeric: tabular-nums; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.55em 0.7em; border-bottom: 1px solid var(--line); }
  .prose :global(th) { font-family: var(--mono); font-weight: 400; font-size: 0.85em; color: #8a8a87; }

  .end { max-width: 68ch; margin-top: calc(56 * var(--u)); padding-top: calc(22 * var(--u)); border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; font-size: calc(14.5 * var(--u)); }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: calc(14 * var(--u)); }
  .tags a, .back { color: #8a8a87; text-decoration: none; }
  .tags a:hover, .back:hover { color: var(--ink); }

  .about { position: sticky; top: calc(40 * var(--u)); align-self: start; display: grid; gap: calc(10 * var(--u)); padding-top: calc(6 * var(--u)); }
  .about-mark {
    width: calc(72 * var(--u)); padding: calc(14 * var(--u)); box-sizing: content-box;
    /* The same tile the home page's projects sit on. */
    background-color: #070708; border-radius: calc(12 * var(--u)); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: calc(25 * var(--u)) calc(25 * var(--u)); background-position: center;
  }
  .about-name { margin: calc(6 * var(--u)) 0 0; font-family: var(--serif); font-size: calc(22 * var(--u)); font-weight: 400; }
  .about-desc { margin: 0; font-size: calc(15 * var(--u)); line-height: 1.45; color: #9a9a97; }
  .about-link { font-family: var(--mono); font-size: calc(13.5 * var(--u)); color: var(--accent); text-decoration: none; }
  .about-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .arr { width: 0.78em; height: 0.78em; vertical-align: -0.05em; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: square; }

  @media (max-width: 860px) {
    .post { grid-template-columns: minmax(0, 1fr); padding: 36px 20px 72px; row-gap: 48px; }
    .head { gap: 12px; margin-bottom: 30px; }
    .meta-row { font-size: 13px; gap: 8px 16px; }
    .project img { width: 14px; }
    h1 { font-size: clamp(32px, 8.6vw, 40px); }
    .lede { font-size: 18px; }
    .prose { font-size: 17.5px; line-height: 1.65; }
    .prose :global(pre) { font-size: 13.5px; margin-left: -20px; margin-right: -20px; border-radius: 0; border-left: 0; border-right: 0; }
    .end { font-size: 13px; margin-top: 40px; }
    .about { position: static; gap: 10px; padding-top: 28px; border-top: 1px solid var(--line); }
    .about-mark { width: 56px; padding: 12px; background-size: 20px 20px; }
    .about-name { font-size: 20px; }
    .about-desc { font-size: 15px; }
    .about-link { font-size: 13.5px; }
  }
</style>
