---
import Base from '../layouts/Base.astro';
import { type Lang, strings } from '../lib/i18n';
import { allPosts, blogHome, formatDate, isPublished, PROJECTS, postPath, tagPath, tagsOf } from '../lib/posts';

interface Props {
  lang: Lang;
  tag?: string;
}

const { lang, tag } = Astro.props;
const t = strings[lang].blog;
const home = blogHome(lang);
// Project tags read as the project's name; other tags stay as written.
const tagLabel = tag ? (PROJECTS[tag as keyof typeof PROJECTS]?.name ?? tag) : undefined;
const posts = (await allPosts()).filter((p) => !tag || tagsOf(p).includes(tag));
const path = tag ? tagPath(lang, tag) : home;
const alternates = { en: tag ? tagPath('en', tag) : blogHome('en'), tr: tag ? tagPath('tr', tag) : blogHome('tr') };
const feedBase = tag ? `${home}tags/${tag}/` : home;
const filters = [{ label: t.all, href: home, on: !tag }, ...Object.entries(PROJECTS).map(([id, p]) => ({ label: p.name, href: tagPath(lang, id), on: tag === id }))];
---

<Base lang={lang} title={tag ? `${t.tagTitle(tagLabel ?? tag)} · Zanaat` : t.metaTitle} description={tag ? t.tagLede(tagLabel ?? tag) : t.lede} path={path} alternates={alternates}>
  <link slot="head" rel="alternate" type="application/feed+json" title={t.title} href={`${feedBase}feed.json`} />
  <main class="index">
    <header class="head">
      <h1>{tag ? t.tagTitle(tagLabel ?? tag) : t.title}</h1>
      <p class="lede">{tag ? t.tagLede(tagLabel ?? tag) : t.lede}</p>
      <div class="bar">
        <nav class="filters" aria-label={t.title}>
          {filters.map((f) => <a href={f.href} aria-current={f.on ? 'page' : undefined}>{f.label}</a>)}
        </nav>
        <p class="feeds">
          <span>{t.feeds}</span>
          <a href={`${feedBase}rss.xml`}>RSS</a>
          <a href={`${feedBase}feed.json`}>JSON</a>
        </p>
      </div>
    </header>

    {posts.length === 0 && <p class="empty">{t.empty}</p>}
    <ol class="list">
      {
        posts.map((p) => {
          const project = PROJECTS[p.data.project];
          const live = isPublished(p);
          return (
            <li class:list={['row', p.data.project, { soon: !live }]}>
              <p class="when">{live ? formatDate(p.data.date, lang) : strings[lang].soon}</p>
              <div class="what">
                <h2 lang={p.data.lang}>{live ? <a href={postPath(p)}>{p.data.title}</a> : p.data.title}</h2>
                <p class="desc" lang={p.data.lang}>{p.data.description}</p>
              </div>
              <p class="meta">
                <a class="project" href={tagPath(lang, p.data.project)}><img src={project.mark} alt="" />{project.name}</a>
                <span class="lang-tag" title={t.langNames[p.data.lang]}>{p.data.lang.toUpperCase()}</span>
              </p>
            </li>
          );
        })
      }
    </ol>
  </main>
</Base>

<style>
  .index { padding: calc(70 * var(--u)) calc(57 * var(--u)) calc(120 * var(--u)); }
  .head { display: grid; gap: calc(16 * var(--u)); margin-bottom: calc(46 * var(--u)); }
  h1 { margin: 0; font-size: calc(56 * var(--u)); font-weight: 600; letter-spacing: -0.012em; line-height: 1.02; }
  .lede { margin: 0; max-width: 58ch; font-size: clamp(17px, calc(15 * var(--u)), 21px); line-height: 1.5; color: #9a9a97; }
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 28px; margin-top: calc(18 * var(--u)); font-family: var(--mono); font-size: calc(14 * var(--u)); }
  .filters { display: flex; flex-wrap: wrap; gap: calc(22 * var(--u)); }
  .filters a { color: #8a8a87; text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid transparent; }
  .filters a:hover { color: var(--ink); }
  .filters a[aria-current] { color: var(--ink); border-bottom-color: var(--ink); }
  .feeds { margin: 0; display: flex; gap: calc(14 * var(--u)); color: #8a8a87; }
  .feeds a { color: var(--ink-2); }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: calc(170 * var(--u)) 1fr calc(170 * var(--u)); gap: calc(28 * var(--u));
    padding: calc(28 * var(--u)) 0; border-bottom: 1px solid var(--line);
  }
  .when { margin: 0; font-family: var(--mono); font-size: calc(13.5 * var(--u)); color: #8a8a87; padding-top: calc(6 * var(--u)); }
  .what h2 { margin: 0; font-size: clamp(22px, calc(22 * var(--u)), 32px); font-weight: 500; line-height: 1.2; letter-spacing: -0.005em; }
  .what h2 a { text-decoration: none; }
  .what h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .desc { margin: calc(10 * var(--u)) 0 0; max-width: 62ch; font-size: clamp(16px, calc(13.5 * var(--u)), 18px); line-height: 1.5; color: #9a9a97; }
  .meta { margin: 0; display: flex; align-items: center; justify-content: flex-end; gap: calc(14 * var(--u)); font-family: var(--mono); font-size: calc(13.5 * var(--u)); padding-top: calc(6 * var(--u)); align-self: start; }
  .project { display: inline-flex; align-items: center; gap: calc(8 * var(--u)); text-decoration: none; color: var(--ink-2); }
  .project img { width: calc(15 * var(--u)); height: auto; }
  .project:hover { color: var(--ink); }
  .lang-tag { color: #8a8a87; }
  .row.soon .what h2 { color: #b4b3ae; }
  .empty { color: #8a8a87; }

  @media (max-width: 860px) {
    .index { padding: 40px 20px 80px; }
    .head { gap: 12px; margin-bottom: 30px; }
    h1 { font-size: clamp(38px, 10vw, 48px); }
    .lede { font-size: 17px; }
    .bar { font-size: 13.5px; margin-top: 10px; }
    .filters { gap: 18px; }
    .feeds { gap: 12px; }
    .row { grid-template-columns: 1fr; gap: 10px; padding: 24px 0; }
    .when { font-size: 13px; padding: 0; }
    .what h2 { font-size: 23px; }
    .desc { font-size: 16px; margin-top: 8px; }
    .meta { justify-content: flex-start; font-size: 13px; padding: 0; gap: 12px; }
    .project img { width: 14px; }
  }
</style>
