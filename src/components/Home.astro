---
import Base from '../layouts/Base.astro';
import { type Lang, strings } from '../lib/i18n';
import { allPosts, blogHome, forLang, formatDate, isPublished, PROJECTS as POST_PROJECTS, postPath, publishedPosts } from '../lib/posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const home = lang === 'en' ? '/' : '/tr/';
const enHome = '/';
const trHome = '/tr/';
const latest = forLang(await allPosts(), lang).slice(0, 2);
const newest = forLang(await publishedPosts(), lang)[0];

const tools = [
  { id: 'lonca', name: 'Lonca', href: 'https://lonca.zanaat.dev/', mark: '/brand/lonca-icon.svg', desc: t.projects.lonca },
  { id: 'baron', name: 'Baron', href: 'https://baron.zanaat.dev/', mark: '/brand/baron.svg', desc: t.projects.baron },
] as const;
const catalogue = [
  {
    id: 'lonca', name: 'Lonca', mark: '/brand/lonca-icon.svg', desc: t.projects.lonca, more: t.projectMore.lonca,
    packages: ['@lonca/core', '@lonca/trendyol', '@lonca/hepsiburada'],
    links: [
      { label: t.links.site, href: 'https://lonca.zanaat.dev/', text: 'lonca.zanaat.dev' },
      { label: t.links.code, href: 'https://github.com/zanaat-dev/lonca', text: 'zanaat-dev/lonca' },
      { label: t.links.npm, href: 'https://www.npmjs.com/org/lonca', text: '@lonca' },
    ],
  },
  {
    id: 'baron', name: 'Baron', mark: '/brand/baron.svg', desc: t.projects.baron, more: t.projectMore.baron,
    packages: ['@zanaat/baron-cli', '@zanaat/baron-mcp-server'],
    links: [
      { label: t.links.site, href: 'https://baron.zanaat.dev/', text: 'baron.zanaat.dev' },
      { label: t.links.code, href: 'https://github.com/zanaat-dev/baron', text: 'zanaat-dev/baron' },
      { label: t.links.npm, href: 'https://www.npmjs.com/org/zanaat', text: '@zanaat' },
    ],
  },
] as const;
---

<Base lang={lang} title={t.title} description={t.description} path={home} alternates={{ en: enHome, tr: trHome }} overlayNav>

      <main>
        <section class="hero" aria-labelledby="headline">
          <div class="stage" data-stage>
            <img class="still" src="/hero-still.webp" alt="" width="2048" height="1144" fetchpriority="high" />
            <canvas tabindex="0" role="img" aria-label={t.objectLabel} data-object></canvas>
          </div>
          <p class="hint" aria-hidden="true">{t.hint}</p>
          {
            newest && (
              <a class="badge" href={postPath(newest)}>
                <strong>{t.newPost}</strong>
                <span lang={newest.data.lang}>{newest.data.title}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg>
              </a>
            )
          }
          <h1 id="headline">{t.headline}</h1>
          <p class="lede">{t.body[0]} <br />{t.body[1]}</p>
          <div class="actions">
            <a class="primary" href="#projects">{t.seeProjects}</a>
            <a class="more" href={blogHome(lang)}>{t.writing} <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h10M7 2.5l3.6 3.5L7 9.5" /></svg></a>
          </div>
          {
            tools.map((p) => (
              <a class={`tool ${p.id}`} href={p.href} aria-label={`${p.name}: ${p.desc}`}>
                <span class="thumb"><img data-thumb={p.id} src={p.mark} alt="" /></span>
                <span class="tool-name">{p.name}</span>
              </a>
            ))
          }
        </section>

        <section class="writing" id="writing" aria-labelledby="writing-h">
          <div class="section-head">
            <h2 id="writing-h">{t.writing}</h2>
            <a class="more" href={blogHome(lang)}>{t.blog.back} <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h10M7 2.5l3.6 3.5L7 9.5" /></svg></a>
          </div>
          <ul class="posts">
            {
              latest.map((p) => (
                <li class={isPublished(p) ? 'post' : 'post soon'}>
                  {isPublished(p) ? (
                    <a class="post-title" href={postPath(p)} lang={p.data.lang}>{p.data.title}</a>
                  ) : (
                    <span class="post-title" lang={p.data.lang}>{p.data.title}</span>
                  )}
                  <span class="post-meta">
                    <img src={POST_PROJECTS[p.data.project].mark} alt="" />
                    {POST_PROJECTS[p.data.project].name} · {p.data.lang.toUpperCase()} · {isPublished(p) ? formatDate(p.data.date, lang) : t.soon}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="projects" id="projects" aria-labelledby="projects-h">
          <div class="section-head">
            <h2 id="projects-h">{t.projectsTitle}</h2>
            <p>{t.projectsLede}</p>
          </div>
          {
            catalogue.map((p) => (
              <article class={`project ${p.id}`}>
                <div class="project-mark"><img src={p.mark} alt="" /></div>
                <div class="project-body">
                  <h3>{p.name}</h3>
                  <p class="project-desc">{p.desc}</p>
                  <p class="project-more">{p.more}</p>
                  <ul class="packages" aria-label="npm">
                    {p.packages.map((pkg) => <li>{pkg}</li>)}
                  </ul>
                </div>
                <dl class="project-links">
                  {
                    p.links.map((l) => (
                      <div>
                        <dt>{l.label}</dt>
                        <dd><a href={l.href}>{l.text}</a></dd>
                      </div>
                    ))
                  }
                </dl>
              </article>
            ))
          }
        </section>

        <section class="open" aria-labelledby="open-h">
          <h2 id="open-h">{t.openTitle}</h2>
          <p>{t.openBody}</p>
          <a class="primary" href="https://github.com/zanaat-dev">{t.openLink}</a>
        </section>
      </main>



    <script>
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      const canvas = stage?.querySelector<HTMLCanvasElement>('canvas');

      const webgl = (() => {
        try {
          const c = document.createElement('canvas');
          return !!(c.getContext('webgl2') || c.getContext('webgl'));
        } catch {
          return false;
        }
      })();

      // The copy never waits for the object: three.js loads after the page has painted, and without
      // WebGL the flat mark stays where the object would be.
      async function start() {
        if (!stage || !canvas || !webgl) return;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const { createObject, renderThumb } = await import('../scripts/object');
        createObject(canvas, { still, onReady: () => (stage.dataset.live = '') });
        for (const img of document.querySelectorAll<HTMLImageElement>('[data-thumb]')) {
          const id = img.dataset.thumb as 'lonca' | 'baron';
          img.src = renderThumb(id, 192);
          img.dataset.rendered = '';
        }
      }

      if (document.readyState === 'complete') start();
      else addEventListener('load', () => start(), { once: true });
    </script>

    <style>
      .hero { position: relative; height: calc(572 * var(--u)); overflow: hidden; isolation: isolate; }
      .hero > * { position: absolute; }

      /* Past the 1200px cap the stage ends inside a wider window; its haze fades out rather than stopping at an edge. */
      .stage { inset: 0; z-index: 0; mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
      .stage canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease); touch-action: pan-y; cursor: grab; }
      .stage canvas:active { cursor: grabbing; }
      .stage canvas:focus-visible { outline: 1px solid rgba(242, 242, 240, 0.5); outline-offset: -12px; border-radius: 20px; }
      .hero:has(canvas:focus-visible) .hint { color: var(--ink); }
      .stage[data-live] canvas { opacity: 1; }
      /* Before (or without) WebGL a still of the same scene, the block in its comp pose, holds the stage;
         the live canvas fades in over it. */
      .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 1s var(--ease); }
      .stage[data-live] .still { opacity: 0; }

      .hint {
        left: 0; right: 0; top: calc(343 * var(--u)); margin: 0; text-align: center; z-index: 1; pointer-events: none;
        font-family: var(--mono); font-size: calc(11.5 * var(--u)); letter-spacing: 0.04em; color: #858587;
      }

      .badge {
        left: 50%; top: calc(369 * var(--u)); transform: translateX(-50%); z-index: 1; max-width: calc(560 * var(--u));
        display: inline-flex; align-items: center; gap: calc(4 * var(--u)); height: calc(22 * var(--u)); margin-top: calc(2 * var(--u)); padding: 0 calc(9 * var(--u)) 0 calc(11 * var(--u));
        border-radius: 999px; background: rgba(28, 28, 30, 0.72); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09);
        font-size: calc(10.5 * var(--u)); letter-spacing: -0.02em; color: #b9b9bb; text-decoration: none; white-space: nowrap;
        transition: box-shadow 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease);
      }
      .badge strong { font-weight: 600; color: var(--ink); }
      .badge span { overflow: hidden; text-overflow: ellipsis; }
      .badge svg { flex: none; width: calc(11 * var(--u)); height: calc(11 * var(--u)); fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform 0.25s var(--ease); }
      .badge:hover { color: var(--ink); background: rgba(36, 36, 39, 0.8); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); }
      .badge:hover svg { transform: translateX(2px); }

      h1 {
        left: 0; right: 0; top: calc(402 * var(--u)); z-index: 1; text-align: center;
        width: fit-content; margin: 0 auto;
        font-family: var(--serif); font-weight: 360; font-size: calc(50 * var(--u)); line-height: calc(60 * var(--u));
        font-variation-settings: 'opsz' 72; font-stretch: 100%; letter-spacing: 0;
        /* The approved comp lights the headline from the left, the way the beam falls: white easing into grey. */
        background: linear-gradient(90deg, #ffffff 0%, #f2f2f0 52%, #9c9c9e 92%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }

      .lede {
        left: 0; right: 0; top: calc(464 * var(--u)); margin: 0; z-index: 1; text-align: center;
        font-size: calc(15 * var(--u)); line-height: calc(19.5 * var(--u)); color: #9b9b9d;
      }

      .actions {
        left: calc(414 * var(--u)); top: calc(516 * var(--u)); z-index: 1;
        display: flex; align-items: center; gap: calc(12 * var(--u));
      }
      .primary {
        display: inline-flex; align-items: center; height: calc(39 * var(--u)); padding: 0 calc(15 * var(--u));
        border-radius: 999px; background: #f4f4f2; color: #0a0a0b; text-decoration: none;
        font-size: calc(14 * var(--u)); font-weight: 450;
        box-shadow: 0 calc(6 * var(--u)) calc(18 * var(--u)) rgba(0, 0, 0, 0.35), inset 0 -1px 0 rgba(0, 0, 0, 0.12);
        transition: background 0.25s var(--ease), transform 0.25s var(--ease);
      }
      .primary:hover { background: #ffffff; }
      .primary:active { transform: translateY(1px); }
      .more {
        position: relative; top: calc(-1 * var(--u)); left: calc(-1 * var(--u));
        display: inline-flex; align-items: center; gap: calc(5 * var(--u)); padding: calc(8 * var(--u)) 0;
        font-size: calc(14.2 * var(--u)); font-weight: 400; letter-spacing: -0.01em; color: #fafaf8; text-decoration: none; transition: color 0.25s var(--ease);
      }
      .more svg { width: calc(14 * var(--u)); height: calc(14 * var(--u)); fill: none; stroke: currentColor; stroke-width: 1.4; transition: transform 0.25s var(--ease); }
      .more:hover { color: #fff; }
      .more:hover svg { transform: translateX(3px); }

      .tool {
        top: calc(505 * var(--u)); width: calc(128 * var(--u)); height: calc(64 * var(--u)); z-index: 1;
        display: flex; align-items: center; gap: calc(12 * var(--u)); padding: calc(6 * var(--u));
        border-radius: calc(12 * var(--u)); background: rgba(14, 14, 15, 0.86); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
        text-decoration: none; color: var(--ink); transition: box-shadow 0.25s var(--ease), background 0.25s var(--ease);
      }
      .tool.lonca { left: calc(56 * var(--u)); }
      .tool.baron { left: calc(841 * var(--u)); }
      .tool:hover { background: rgba(22, 22, 24, 0.92); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); }
      .thumb {
        flex: none; width: calc(52 * var(--u)); height: calc(52 * var(--u)); border-radius: calc(8 * var(--u)); overflow: hidden;
        display: grid; place-items: center; background: radial-gradient(circle at 50% 30%, #2a2b2e, #0d0d0e 70%);
      }
      .thumb img { width: 46%; height: auto; opacity: 0.85; }
      .thumb img[data-rendered] { width: 100%; height: 100%; object-fit: cover; opacity: 1; }
      .tool-name { font-size: calc(14.5 * var(--u)); font-weight: 400; color: #e6e6e8; }

      /* Below the first viewport the page keeps the hero's voice: serif headings, Geist text, hairline
         panels lit faintly from above, pills for the small things. */
      .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: calc(12 * var(--u)) calc(40 * var(--u)); }
      .section-head h2, .open h2 {
        margin: 0; font-family: var(--serif); font-weight: 400; font-size: calc(36 * var(--u)); line-height: 1.15;
        font-variation-settings: 'opsz' 144; letter-spacing: -0.012em; word-spacing: 0.06em; color: var(--ink);
      }
      .section-head p { margin: 0; max-width: 44ch; font-size: calc(15.5 * var(--u)); line-height: 1.55; color: #9b9b9d; }

      .writing { padding: calc(96 * var(--u)) calc(57 * var(--u)) 0; }
      .posts { list-style: none; margin: calc(26 * var(--u)) 0 0; padding: 0; border-top: 1px solid var(--line); }
      .post {
        display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: calc(8 * var(--u)) calc(32 * var(--u));
        padding: calc(22 * var(--u)) 0; border-bottom: 1px solid var(--line);
      }
      .post-title { font-size: calc(19 * var(--u)); font-weight: 500; line-height: 1.3; letter-spacing: -0.005em; color: var(--ink); text-wrap: balance; }
      a.post-title { text-decoration: none; transition: color 0.25s var(--ease); }
      a.post-title:hover { color: #fff; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: rgba(255, 255, 255, 0.35); }
      .post.soon .post-title { color: #8e8e8f; }
      .post-meta {
        display: inline-flex; align-items: center; gap: calc(8 * var(--u)); flex: none;
        font-family: var(--mono); font-size: calc(12.5 * var(--u)); color: #8a8a87; font-variant-numeric: tabular-nums;
      }
      .post-meta img { width: calc(13 * var(--u)); height: auto; }

      .projects { padding: calc(112 * var(--u)) calc(57 * var(--u)) 0; }
      .projects .section-head { margin-bottom: calc(30 * var(--u)); }
      .project {
        position: relative; display: grid; grid-template-columns: calc(132 * var(--u)) minmax(0, 1fr) calc(230 * var(--u)); gap: calc(36 * var(--u));
        padding: calc(32 * var(--u)); border-radius: calc(20 * var(--u));
        background: radial-gradient(120% 90% at 50% -30%, rgba(160, 178, 196, 0.07), transparent 60%), #0b0b0d;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }
      .project + .project { margin-top: calc(14 * var(--u)); }
      .project-mark {
        width: calc(132 * var(--u)); aspect-ratio: 1; display: grid; place-items: center; border-radius: calc(14 * var(--u));
        /* The module grid every mark is drawn on. */
        background-color: #070708;
        background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: calc(22 * var(--u)) calc(22 * var(--u)); background-position: center;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
      }
      .project-mark img { width: 52%; height: auto; }
      .project h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: calc(30 * var(--u)); line-height: 1.15; letter-spacing: -0.01em; font-variation-settings: 'opsz' 144; }
      .project-desc { margin: calc(10 * var(--u)) 0 0; font-size: calc(17 * var(--u)); color: var(--ink); line-height: 1.4; }
      .project-more { margin: calc(10 * var(--u)) 0 0; max-width: 62ch; font-size: calc(15 * var(--u)); line-height: 1.6; color: #9b9b9d; }
      .packages { list-style: none; margin: calc(20 * var(--u)) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: calc(8 * var(--u)); }
      .packages li {
        display: inline-flex; align-items: center; height: calc(26 * var(--u)); padding: 0 calc(11 * var(--u)); border-radius: 999px;
        font-family: var(--mono); font-size: calc(12 * var(--u)); color: #c4c4c6; background: rgba(255, 255, 255, 0.03); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
      }
      .project-links { margin: 0; align-self: start; border-top: 1px solid var(--line); }
      .project-links div { display: grid; grid-template-columns: calc(64 * var(--u)) 1fr; gap: calc(10 * var(--u)); align-items: baseline; padding: calc(11 * var(--u)) 0; border-bottom: 1px solid var(--line); }
      .project-links dt { font-family: var(--mono); font-size: calc(12 * var(--u)); color: #8a8a87; }
      .project-links dd { margin: 0; font-family: var(--mono); font-size: calc(13.5 * var(--u)); overflow-wrap: anywhere; }
      .project-links a { text-decoration: none; text-underline-offset: 3px; transition: color 0.25s var(--ease); }
      .project-links a:hover { text-decoration: underline; }
      .project.lonca .project-links a { color: var(--lonca-ink); }
      .project.baron .project-links a { color: var(--baron); }

      /* The close: the beam once more, faintly, over the invitation. */
      .open {
        position: relative; display: grid; justify-items: center; text-align: center; gap: calc(14 * var(--u));
        margin-top: calc(40 * var(--u)); padding: calc(96 * var(--u)) calc(57 * var(--u)) calc(110 * var(--u));
      }
      .open::before {
        content: ''; position: absolute; left: 50%; top: 0; width: calc(640 * var(--u)); height: 100%; transform: translateX(-50%); z-index: -1;
        background: radial-gradient(50% 70% at 50% 0%, rgba(150, 170, 188, 0.12), transparent 70%);
      }
      .open p { margin: 0; max-width: 46ch; font-size: calc(16 * var(--u)); line-height: 1.55; color: #9b9b9d; }
      .open .primary { margin-top: calc(14 * var(--u)); }

      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      /* Phones and narrow tablets: the hero leaves its measured stage and stacks; the board keeps its own frame. */
      @media (max-width: 860px) {
        .hero { height: auto; padding: 0 20px 36px; display: flex; flex-direction: column; align-items: center; text-align: center; overflow: visible; }
        .hero > * { position: relative; left: auto; right: auto; top: auto; transform: none; }
        /* The stage's lower part is only the beam's reflection on the floor; the copy rises over it. */
        .stage { position: relative; inset: auto; width: calc(100% + 40px); margin: 0 -20px -30%; aspect-ratio: 1 / 1.05; }
        .hint { margin-top: -10px; font-size: 11.5px; }
        .badge { margin-top: 22px; max-width: 100%; height: 30px; font-size: 12.5px; padding: 0 10px 0 12px; }
        .badge svg { width: 11px; height: 11px; }
        h1 { margin-top: 18px; font-size: clamp(34px, 10vw, 44px); line-height: 1.12; text-wrap: balance; }
        .lede { margin-top: 14px; font-size: 16px; line-height: 1.5; max-width: 34ch; }
        .lede br { display: none; }
        .actions { margin-top: 22px; padding-left: 0; gap: 14px; }
        .primary { height: 44px; padding: 0 20px; font-size: 15px; }
        .more { font-size: 15px; }
        .tool { display: none; }
        .section-head h2, .open h2 { font-size: 30px; }
        .section-head p { font-size: 15.5px; }
        .writing { padding: 64px 20px 0; }
        .posts { margin-top: 20px; }
        .post { padding: 18px 0; gap: 8px; }
        .post-title { font-size: 18px; }
        .post-meta { font-size: 12px; }
        .post-meta img { width: 13px; }
        .projects { padding: 72px 20px 0; }
        .projects .section-head { margin-bottom: 22px; }
        .project { grid-template-columns: 1fr; gap: 20px; padding: 22px; border-radius: 18px; }
        .project-mark { width: 84px; border-radius: 12px; background-size: 16px 16px; }
        .project h3 { font-size: 26px; }
        .project-desc { font-size: 16.5px; }
        .project-more { font-size: 15px; }
        .packages li { height: 26px; font-size: 12px; padding: 0 10px; }
        .project-links div { grid-template-columns: 64px 1fr; padding: 10px 0; }
        .project-links dt { font-size: 12px; }
        .project-links dd { font-size: 13.5px; }
        .open { margin-top: 24px; padding: 64px 20px 72px; gap: 12px; }
        .open::before { width: 100%; }
        .open p { font-size: 16px; }
      }
    </style>
</Base>
