      .open { padding: calc(100 * var(--u)) calc(57 * var(--u)) calc(110 * var(--u)); display: grid; grid-template-columns: calc(465 * var(--u)) 1fr; align-items: baseline; row-gap: calc(10 * var(--u)); }
