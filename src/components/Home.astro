      .open a:hover { text-decoration: underline; text-underline-offset: 3px; }

      .foot {
        display: flex; flex-wrap: wrap; align-items: center; gap: calc(16 * var(--u)) calc(28 * var(--u));
        padding: calc(28 * var(--u)) calc(57 * var(--u)) calc(40 * var(--u)); border-top: 1px solid var(--line);
        font-family: var(--mono); font-size: calc(13 * var(--u)); color: #8a8a87;
